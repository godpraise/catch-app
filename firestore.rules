rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function logged() { return request.auth != null; }
  function roomPath(c) { return /databases/$(database)/documents/rooms/$(c); }
  function playerPath(c,u) { return /databases/$(database)/documents/rooms/$(c)/players/$(u); }
  function member(c) { return logged() && exists(playerPath(c,request.auth.uid)); }
  function host(c) { return member(c) && get(roomPath(c)).data.hostId == request.auth.uid; }
  function current(c) { return member(c) && get(playerPath(c,request.auth.uid)).data.roundId == get(roomPath(c)).data.roundId; }
  function tagger(c) { return current(c) && get(roomPath(c)).data.taggerId == request.auth.uid && get(playerPath(c,request.auth.uid)).data.role == 'tagger'; }
  function runner(c) { return current(c) && get(roomPath(c)).data.status == 'playing' && get(playerPath(c,request.auth.uid)).data.role == 'runner' && get(playerPath(c,request.auth.uid)).data.status == 'alive'; }
  function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
  match /rooms/{c} {
   allow get: if logged() && (!exists(roomPath(c)) || resource.data.status == 'waiting' || member(c));
   allow list, delete: if false;
   allow create: if logged() && c.matches('^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6}$')
    && request.resource.data.keys().hasOnly(['hostId','status','maxPlayers','hideTimeSec','timeLimitSec','createdAt','startedAt','taggerId','roundId'])
    && request.resource.data.hostId == request.auth.uid && request.resource.data.status == 'waiting'
    && request.resource.data.roundId == 0 && request.resource.data.taggerId == null
    && request.resource.data.createdAt == request.time && request.resource.data.startedAt == null
    && request.resource.data.maxPlayers is int && request.resource.data.maxPlayers >= 2 && request.resource.data.maxPlayers <= 30
    && request.resource.data.hideTimeSec is int && request.resource.data.hideTimeSec >= 0 && request.resource.data.hideTimeSec <= 600
    && request.resource.data.timeLimitSec is int && request.resource.data.timeLimitSec >= 30 && request.resource.data.timeLimitSec <= 7200;
   allow update: if
    (host(c) && resource.data.status in ['waiting','ended'] && only(['status','startedAt','taggerId','roundId'])
     && request.resource.data.status == 'hiding' && request.resource.data.startedAt == request.time
     && request.resource.data.roundId == resource.data.roundId + 1
     && exists(playerPath(c,request.resource.data.taggerId))
     && getAfter(playerPath(c,request.resource.data.taggerId)).data.role == 'tagger'
     && getAfter(playerPath(c,request.resource.data.taggerId)).data.roundId == request.resource.data.roundId)
    || (host(c) && resource.data.status == 'hiding' && request.resource.data.status == 'playing' && only(['status'])
     && request.time >= resource.data.startedAt + duration.value(resource.data.hideTimeSec,'s'))
    || ((host(c) || tagger(c)) && resource.data.status == 'playing' && request.resource.data.status == 'ended' && only(['status']));
   match /players/{u} {
    function reset() {
     return request.resource.data.status == 'alive' && request.resource.data.caughtAt == null
      && request.resource.data.caughtBy == null && request.resource.data.caughtPhotoUrl == null
      && request.resource.data.missionType == null && request.resource.data.missionStatus == null
      && request.resource.data.missionAssignedAt == null && request.resource.data.missionPhotoUrl == null;
    }
    allow get: if member(c) || (logged() && request.auth.uid == u && get(roomPath(c)).data.status == 'waiting');
    allow list: if member(c);
    allow create: if logged() && request.auth.uid == u && getAfter(roomPath(c)).data.status == 'waiting'
     && request.resource.data.keys().hasOnly(['nickname','profileImage','role','status','caughtAt','caughtBy','caughtPhotoUrl','missionType','missionStatus','missionAssignedAt','missionPhotoUrl','joinedAt','roundId'])
     && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 40
     && (request.resource.data.profileImage == null || (request.resource.data.profileImage is string && request.resource.data.profileImage.size() <= 2048))
     && request.resource.data.role == null && request.resource.data.roundId == 0 && request.resource.data.joinedAt == request.time && reset();
    allow update: if
     (host(c) && get(roomPath(c)).data.status in ['waiting','ended'] && getAfter(roomPath(c)).data.status == 'hiding'
      && getAfter(roomPath(c)).data.roundId == get(roomPath(c)).data.roundId + 1
      && only(['role','status','caughtAt','caughtBy','caughtPhotoUrl','missionType','missionStatus','missionAssignedAt','missionPhotoUrl','roundId'])
      && request.resource.data.roundId == getAfter(roomPath(c)).data.roundId
      && request.resource.data.role == (u == getAfter(roomPath(c)).data.taggerId ? 'tagger' : 'runner') && reset())
     || (tagger(c) && get(roomPath(c)).data.status == 'playing' && resource.data.role == 'runner'
      && resource.data.roundId == get(roomPath(c)).data.roundId && resource.data.status == 'alive'
      && only(['status','caughtAt','caughtBy','caughtPhotoUrl']) && request.resource.data.status == 'caught'
      && request.resource.data.caughtAt == request.time && request.resource.data.caughtBy == request.auth.uid
      && request.resource.data.caughtPhotoUrl is string && request.resource.data.caughtPhotoUrl.size() > 0 && request.resource.data.caughtPhotoUrl.size() <= 4096)
     || (current(c) && request.auth.uid == u && get(roomPath(c)).data.status in ['hiding','playing']
      && resource.data.status == 'alive' && only(['location'])
      && request.resource.data.location.keys().hasOnly(['lat','lng','updatedAt'])
      && request.resource.data.location.lat is number && request.resource.data.location.lat >= -90 && request.resource.data.location.lat <= 90
      && request.resource.data.location.lng is number && request.resource.data.location.lng >= -180 && request.resource.data.location.lng <= 180
      && request.resource.data.location.updatedAt is int)
     || (runner(c) && request.auth.uid == u && only(['missionType','missionStatus','missionAssignedAt','missionPhotoUrl'])
      && ((resource.data.missionStatus != 'pending' && request.resource.data.missionStatus == 'pending'
        && request.resource.data.missionType in ['selfie','sneaky_tagger','sky','feet','nearest_tree','finger_heart']
        && request.resource.data.missionAssignedAt == request.time && request.resource.data.missionPhotoUrl == null)
       || (resource.data.missionStatus == 'pending' && request.resource.data.missionType == resource.data.missionType
        && request.resource.data.missionAssignedAt == resource.data.missionAssignedAt
        && ((request.resource.data.missionStatus == 'completed' && request.resource.data.missionPhotoUrl is string && request.resource.data.missionPhotoUrl.size() > 0 && request.resource.data.missionPhotoUrl.size() <= 4096)
         || (request.resource.data.missionStatus == 'failed' && request.resource.data.missionPhotoUrl == resource.data.missionPhotoUrl)))));
    allow delete: if logged() && request.auth.uid == u && get(roomPath(c)).data.status in ['waiting','ended'];
   }
  }
  // These client-updated stats are self-reported; no authoritative ranking is claimed.
  match /users/{u} { allow read, write: if logged() && request.auth.uid == u; }
  match /{document=**} { allow read, write: if false; }
 }
}
